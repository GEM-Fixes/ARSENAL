{"form":"determ-commands/1",
"note":"static tools on fixtures inside the repo. {R} = repo root, {T} = per-run temp folder. setup runs without shim in the run's own root; out: stdout | stderr | file:<rel to {T}> | dir:<rel to {T}>. No command may start a game or editor or need G/H.",
"commands":[
 {"id":"check-m2","tool":"check","setup":[["node","{R}/tools/fix/test/mkfixture.js","{T}/fx"]],
  "args":["{R}/tools/check/check.js","{T}/fx/game/mods/m2","--game","{T}/fx/game","--exe","mowas2","--json","{T}/check.json"],"out":["stdout","file:check.json"]},
 {"id":"check-m1","tool":"check","setup":[["node","{R}/tools/fix/test/mkfixture.js","{T}/fx"]],
  "args":["{R}/tools/check/check.js","{T}/fx/game/mods/m1","--game","{T}/fx/game","--exe","mowas2"],"out":["stdout"]},
 {"id":"fix-plan","tool":"fix","setup":[["node","{R}/tools/fix/test/mkfixture.js","{T}/fx"]],
  "args":["{R}/tools/fix/fix.js","{T}/fx/game/mods/m1","plan","--game","{T}/fx/game","--json","{T}/fix.json"],"out":["stdout","file:fix.json"]},
 {"id":"fix-apply","tool":"fix","setup":[["node","{R}/tools/fix/test/mkfixture.js","{T}/fx"]],
  "args":["{R}/tools/fix/fix.js","{T}/fx/game/mods/m1","apply","--out","{T}/pf","--game","{T}/fx/game"],"out":["stdout","dir:pf"]},
 {"id":"upgrade-plan","tool":"upgrade","setup":[["node","{R}/tools/fix/test/mkfixture.js","{T}/fx"]],
  "args":["{R}/tools/upgrade/upgrade.js","{T}/fx/game/mods/m1","--to","goh","--plan","--as2","{T}/fx/game","--goh","{T}/none","--out","{T}/up"],"out":["stdout","dir:up"]},
 {"id":"upgrade-out","tool":"upgrade","setup":[["node","{R}/tools/fix/test/mkfixture.js","{T}/fx"]],
  "args":["{R}/tools/upgrade/upgrade.js","{T}/fx/game/mods/m1","--to","as64","--out","{T}/up2","--as2","{T}/fx/game","--goh","{T}/none"],"out":["stdout","dir:up2"]},
 {"id":"gen-squad","tool":"gen","setup":[["node","{R}/tools/gen/test/mkfixture.js","{T}/g"]],
  "args":["{R}/tools/gen/gen.js","{R}/tools/determ/fx/gen.json","--target","mowas2","--game","{T}/g/as2","--no-gate","--no-stat","--out","{T}/gout"],"out":["stdout","dir:gout"]},
 {"id":"sdllint-bad","tool":"sdllint","setup":[{"copy":["{R}/tools/sdllint/test/bad","{T}/bad"]}],
  "args":["{R}/tools/sdllint/sdllint.js","{T}/bad"],"out":["stdout"]},
 {"id":"keylint-bad","tool":"keylint","setup":[{"copy":["{R}/tools/keylint/test/bad","{T}/bad"]}],
  "args":["{R}/tools/keylint/keylint.js","{T}/bad"],"out":["stdout"]},
 {"id":"refcheck-text","tool":"refcheck","setup":[{"run":["node","{R}/tools/refcheck/test/mkfixture.js"],"env":{"TEST_WORK":"{T}"}}],
  "args":["{R}/tools/refcheck/refcheck.js","-","--folder","{T}/fx","--cache","{T}/fx.cache.json"],"out":["stdout"]},
 {"id":"refcheck-json","tool":"refcheck","setup":[{"run":["node","{R}/tools/refcheck/test/mkfixture.js"],"env":{"TEST_WORK":"{T}"}}],
  "args":["{R}/tools/refcheck/refcheck.js","-","--folder","{T}/fx","--cache","{T}/fx.cache.json","-q","--format","json","-o","{T}/rc.json"],"out":["stdout","file:rc.json"]},
 {"id":"wouldload-m1","tool":"wouldload","setup":[["node","{R}/tools/fix/test/mkfixture.js","{T}/fx"]],
  "args":["{R}/tools/wouldload/wouldload.js","{T}/fx/game/mods/m1","--exe","mowas2","--game","{T}/fx/game","--json","{T}/wl.json"],"out":["stdout","file:wl.json"]},
 {"id":"packer-dry","tool":"packer","setup":[{"copy":["{R}/tools/packer/test/fixture/mod","{T}/mod"]}],
  "args":["{R}/tools/packer/packer.js","{T}/mod","-q"],"out":["stdout"]},
 {"id":"packer-out","tool":"packer","setup":[{"copy":["{R}/tools/packer/test/fixture/mod","{T}/mod"]}],
  "args":["{R}/tools/packer/packer.js","{T}/mod","--out","{T}/pk"],"out":["stdout","dir:pk"]},
 {"id":"native-seed","tool":"native","setup":[["node","{R}/tools/determ/fx/mknative.js","{T}/n"]],
  "args":["{R}/tools/native/native.js","{T}/n/mod","--game","{T}/n/game","--table","{T}/n/table.json","--class","tank_medium","-o","{T}/native.json"],"out":["stdout","file:native.json"]},
 {"id":"goh2as2-tank","tool":"goh2as2","setup":[{"copy":["{R}/tools/goh2as2/test/fixture/goh","{T}/goh"]},{"copy":["{R}/tools/goh2as2/test/fixture/keys.txt","{T}/keys.txt"]}],
  "args":["{R}/tools/goh2as2/goh2as2.js","--goh","{T}/goh","--entity","tank","--keys","{T}/keys.txt","--out","{T}/out","--no-keylint","--no-rc"],"out":["stdout","dir:out"]},
 {"id":"conflicts-itm","tool":"conflicts","setup":[{"copy":["{R}/tools/conflicts/test/fixture/game","{T}/game"]}],
  "args":["{R}/tools/conflicts/conflicts.js","--game","{T}/game","--mods","ma,mb","--itm","--keys"],"out":["stdout"]},
 {"id":"misdiff-text","tool":"misdiff","setup":[{"copy":["{R}/tools/misdiff/test/fixture","{T}/fx"]}],
  "args":["{R}/tools/misdiff/misdiff.js","{T}/fx/a","{T}/fx/b"],"out":["stdout"]},
 {"id":"misdiff-json","tool":"misdiff","setup":[{"copy":["{R}/tools/misdiff/test/fixture","{T}/fx"]}],
  "args":["{R}/tools/misdiff/misdiff.js","{T}/fx/a","{T}/fx/b","--format","json"],"out":["stdout"]},
 {"id":"doctor-m1","tool":"doctor","setup":[{"run":["node","{R}/tools/binhdr/test/mkfixture.js"],"env":{"TEST_WORK":"{T}"}}],
  "args":["{R}/tools/doctor/doctor.js","{T}/fixture/game/mods/m1","--out","{T}/dout"],"out":["stdout","dir:dout"],"timeout":400000},
 {"id":"doctor-release","tool":"doctor","setup":[{"run":["node","{R}/tools/doctor/test/mkrelease.js"],"env":{"TEST_WORK":"{T}"}}],
  "args":["{R}/tools/doctor/doctor.js","{T}/rel/m","--release"],"out":["stdout"]},
 {"id":"modinfo-mods","tool":"modinfo","setup":[{"copy":["{R}/tools/modinfo/test/fixture/mods","{T}/mods"]}],
  "args":["{R}/tools/modinfo/modinfo.js","{T}/mods"],"out":["stdout"]}
]}
