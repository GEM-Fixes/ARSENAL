<?xml version="1.0" encoding="UTF-8" ?>
<NotepadPlus>
	<functionList>
		<parser displayName="INI Section" id="ini_section" commentExpr="(?m-s:[;\#].*$)">
			<function mainExpr="^\h*\[[\w.]+\]">
				<functionName><nameExpr expr="[^[\]]*" /></functionName>
			</function>
		</parser>
	</functionList>
</NotepadPlus>
