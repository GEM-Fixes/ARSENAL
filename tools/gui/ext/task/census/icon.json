{
  "thing": "icon",
  "files": [
    "interface/scene/unit_icon/*.tga",
    "interface/scene/unit_icon_small/*.tga",
    "interface/scene/portrait/*.tga",
    "interface/scene/squad/*.tga",
    "interface/scene/structure/<vehicle>/scheme.tga",
    "interface/scene/structure/<vehicle>/*.mtl",
    "interface/scene/panel_control/*.tga",
    "interface/scene/vehicle_view/<model>/<part>.ebm",
    "entity/**/*.mdl {extender \"preview\"}",
    "set/breed/**",
    "set/multiplayer/**",
    "interface/minimap.set",
    "text/**/*.lng"
  ],
  "groups": [
    { "id": "buy", "name": "Buy card (unit_icon)" },
    { "id": "small", "name": "Small card (unit_icon_small)" },
    { "id": "soldier", "name": "Soldier pictures (portrait, squad, breed)" },
    { "id": "category", "name": "Category buttons and side markers" },
    { "id": "structure", "name": "Damage scheme (structure)" },
    { "id": "preview", "name": "Inventory picture (preview extender)" },
    { "id": "panel", "name": "Panel buttons" },
    { "id": "text", "name": "Card text" }
  ],
  "vars": [
    { "key": "buy.file", "where": "interface/scene/unit_icon/<name>_NN.tga", "type": "file", "plain": "Large card in the MP buy menu and stats screen", "unit": "", "vanilla": { "values": ["2992 files"] }, "count": 2992, "group": "buy", "ref": "", "tool": "Art: /art/icons, /art/icon-png kind icon", "limit": "UI-03 (missing gives no error)", "tag": "V" },
    { "key": "buy.size", "where": "TGA header", "type": "text", "plain": "Card size", "unit": "px", "vanilla": { "values": ["104x52"] }, "count": 2992, "group": "buy", "ref": "", "tool": "Art: /art/icon-png --size", "limit": "", "tag": "V" },
    { "key": "buy.frames", "where": "file suffix _00.._03", "type": "list", "plain": "Four frames: normal, hover, pressed, disabled", "unit": "frames", "vanilla": { "values": ["_00 825", "_01 825", "_02 825", "_03 825"] }, "count": 825, "group": "buy", "ref": "", "tool": "Art: /art/icon-png", "limit": "", "tag": "I" },
    { "key": "buy.format", "where": "TGA header", "type": "choice", "plain": "32-bit uncompressed TGA (type 2)", "unit": "", "vanilla": { "values": ["tga32 type2"] }, "count": 2992, "group": "buy", "ref": "", "tool": "artport convert", "limit": "", "tag": "V" },
    { "key": "buy.squad_name", "where": "unit_icon/<squad>(<army>)_NN.tga", "type": "text", "plain": "Squad cards carry army in brackets, e.g. riflemans(eng)_00", "unit": "", "vanilla": { "values": ["riflemans(eng)"] }, "count": 0, "group": "buy", "ref": "soldier.breed_icon", "tool": "gen card/roster icon_like (copy only)", "limit": "", "tag": "V" },
    { "key": "buy.stats_name", "where": "Stats screen: <breed icon>(<nationality>)", "type": "ref", "plain": "Stats screen picks unit_icon/<icon>(<nationality>)", "unit": "", "vanilla": { "values": ["rifleman(eng)_00.tga"] }, "count": 0, "group": "buy", "ref": "soldier.breed_icon", "tool": "", "limit": "", "tag": "V" },
    { "key": "small.file", "where": "interface/scene/unit_icon_small/<def stem>NN.tga", "type": "file", "plain": "Small card for vehicles and guns, by def stem; fallback icon_stub", "unit": "", "vanilla": { "values": ["2965 files"] }, "count": 2965, "group": "small", "ref": "", "tool": "Art: /art/icon-png kind icon", "limit": "UI-03", "tag": "V" },
    { "key": "small.size", "where": "TGA header", "type": "text", "plain": "Small card size", "unit": "px", "vanilla": { "values": ["112x48"] }, "count": 2965, "group": "small", "ref": "", "tool": "Art: /art/icon-png --size", "limit": "", "tag": "V" },
    { "key": "small.frames", "where": "file suffix 00..03 (no underscore)", "type": "list", "plain": "Four frames", "unit": "frames", "vanilla": { "values": ["00", "01", "02", "03"] }, "count": 0, "group": "small", "ref": "", "tool": "Art: /art/icon-png", "limit": "FMT-04 frame suffix", "tag": "V" },
    { "key": "soldier.portrait", "where": "breed {portrait \"x\"} → interface/scene/portrait/<x>.tga", "type": "ref", "plain": "Soldier face picture; default skeleton", "unit": "", "vanilla": { "values": ["86 files", "97x135 px", "single frame"] }, "count": 86, "group": "soldier", "ref": "", "tool": "Art: /art/icon-png kind portrait; gen breed", "limit": "UI-03", "tag": "V" },
    { "key": "soldier.squad_card", "where": "interface/scene/squad/<portrait title>_NN.tga", "type": "file", "plain": "Unit-list card for one soldier", "unit": "", "vanilla": { "values": ["405 files", "48x48 px", "_00.._02 (134 each)"] }, "count": 405, "group": "soldier", "ref": "soldier.portrait", "tool": "", "limit": "UI-03", "tag": "V" },
    { "key": "soldier.breed_icon", "where": "breed {icon \"x\"} → squad/<x> via GetIcon", "type": "ref", "plain": "Small soldier icon", "unit": "", "vanilla": { "values": ["rifleman", "mg", "officer"] }, "count": 286, "group": "soldier", "ref": "", "tool": "gen breed (spec.set)", "limit": "", "tag": "V" },
    { "key": "soldier.icon_priority", "where": "breed {icon_priority N}", "type": "number", "plain": "Which soldier's icon stands for the squad", "unit": "", "vanilla": { "min": 0, "max": 10, "common": 3 }, "count": 286, "group": "soldier", "ref": "", "tool": "gen breed", "limit": "", "tag": "V" },
    { "key": "soldier.nationality", "where": "breed {nationality \"eng\"}", "type": "text", "plain": "Army tag used in icon names and voice", "unit": "", "vanilla": { "values": ["eng", "ger", "rus", "usa", "jap"] }, "count": 286, "group": "soldier", "ref": "", "tool": "gen breed", "limit": "", "tag": "V" },
    { "key": "category.button", "where": "unit_icon/<T>(A)_NN.tga and <T>_NN.tga", "type": "file", "plain": "MP buy-menu category button (active and plain)", "unit": "", "vanilla": { "values": ["104x52"] }, "count": 0, "group": "category", "ref": "", "tool": "", "limit": "", "tag": "I" },
    { "key": "category.hint", "where": "lng mp/scene/hint_<T>", "type": "text", "plain": "Tooltip text for a category button", "unit": "", "vanilla": { "values": [] }, "count": 0, "group": "category", "ref": "", "tool": "", "limit": "", "tag": "I" },
    { "key": "category.side_marker", "where": "squad/icon_tank(<nation>)_NN, icon_cannon(...), icon_vehicle(...)", "type": "file", "plain": "Side marker per nation", "unit": "", "vanilla": { "values": ["48x48", "3 frames"] }, "count": 0, "group": "category", "ref": "", "tool": "", "limit": "", "tag": "V" },
    { "key": "structure.scheme", "where": "interface/scene/structure/<vehicle>/scheme.tga", "type": "file", "plain": "Damage scheme background", "unit": "px", "vanilla": { "values": ["97x140"] }, "count": 0, "group": "structure", "ref": "", "tool": "", "limit": "", "tag": "V" },
    { "key": "structure.part", "where": "structure/<vehicle>/<part>.mtl (body, turret, gun, wheelleft ...)", "type": "list", "plain": "Per-part overlay that lights up when hit; names match volumes", "unit": "", "vanilla": { "values": ["body.mtl", "turret.mtl", "gun.mtl", "wheelleft.mtl"] }, "count": 0, "group": "structure", "ref": "", "tool": "", "limit": "", "tag": "I" },
    { "key": "structure.vehicle_view", "where": "interface/scene/vehicle_view/<model>/<part>.ebm", "type": "file", "plain": "Optional vehicle view parts", "unit": "", "vanilla": { "values": ["0 vanilla files"] }, "count": 0, "group": "structure", "ref": "", "tool": "", "limit": "", "tag": "T" },
    { "key": "preview.mode", "where": "mdl {extender \"preview\" {stuff|stuff_primary|stuff_secondary|reload|weapon_view}}", "type": "choice", "plain": "Which inventory slot the live render is for", "unit": "", "vanilla": { "values": ["stuff 322", "stuff_primary 202", "stuff_secondary 38"] }, "count": 322, "group": "preview", "ref": "", "tool": "", "limit": "", "tag": "V" },
    { "key": "preview.camera.origin", "where": "{camera {origin x y z}}", "type": "text", "plain": "Camera position", "unit": "m", "vanilla": { "values": [] }, "count": 322, "group": "preview", "ref": "", "tool": "", "limit": "", "tag": "V" },
    { "key": "preview.camera.lookat", "where": "{camera {lookat x y z}}", "type": "text", "plain": "Camera target", "unit": "m", "vanilla": { "values": [] }, "count": 322, "group": "preview", "ref": "", "tool": "", "limit": "", "tag": "V" },
    { "key": "preview.camera.horizon", "where": "{camera {horizon}}", "type": "text", "plain": "Camera up / horizon", "unit": "", "vanilla": { "values": [] }, "count": 0, "group": "preview", "ref": "", "tool": "", "limit": "", "tag": "I" },
    { "key": "preview.camera.fov", "where": "{camera {fov N}}", "type": "number", "plain": "Field of view", "unit": "deg", "vanilla": { "values": [] }, "count": 0, "group": "preview", "ref": "", "tool": "", "limit": "", "tag": "I" },
    { "key": "preview.lights", "where": "{lights {# {type directional|point|spot}{direction}{position}{diffuse}{ambient}{range}{theta}{phi}{falloff}}}", "type": "list", "plain": "Lights for the inventory render", "unit": "", "vanilla": { "values": ["directional", "point", "spot"] }, "count": 0, "group": "preview", "ref": "", "tool": "", "limit": "missing model logs 'Can't render entity preview'", "tag": "V" },
    { "key": "panel.file", "where": "interface/scene/panel_control/*.tga", "type": "file", "plain": "Command panel buttons", "unit": "px", "vanilla": { "values": ["44x44 256 files", "27x27", "up to 16 frames"] }, "count": 256, "group": "panel", "ref": "", "tool": "", "limit": "", "tag": "V" },
    { "key": "minimap.symbol", "where": "interface/minimap.set", "type": "text", "plain": "Minimap draws symbols with colours from minimap.set; no per-unit minimap picture", "unit": "", "vanilla": { "values": [] }, "count": 1, "group": "panel", "ref": "", "tool": "", "limit": "", "tag": "V" },
    { "key": "text.desc", "where": "lng desc/entity/<id>, desc/squad/<id>", "type": "text", "plain": "Card name text", "unit": "", "vanilla": { "values": [] }, "count": 0, "group": "text", "ref": "", "tool": "gen card", "limit": "", "tag": "I" },
    { "key": "text.info", "where": "lng info/...", "type": "text", "plain": "Card info text", "unit": "", "vanilla": { "values": [] }, "count": 0, "group": "text", "ref": "", "tool": "gen card", "limit": "", "tag": "I" }
  ],
  "gaps": [
    "Art icon-png (tools/gui/ext/art/core.js pngPlan) falls back to 128x128 / 64x64 / 64x64 for a new unit; vanilla is 104x52 / 112x48 / 97x135; step: change the three fallback sizes",
    "icon-png has no squad 48x48 kind (portrait title, _00.._02); step: add kind squad",
    "No category button (T(A)/T) or hint text writer; step: add kind category writing two files + mp/scene/hint_<T>",
    "No damage scheme writer (structure/<vehicle>/scheme.tga + part .mtl); step: /art/structure route copying a vanilla folder and renaming parts to the vehicle volumes",
    "No preview extender editor (camera origin/lookat/fov, lights); step: Models op preview.set with a live render in the viewer",
    "Frame meaning of _00.._03 (normal/hover/pressed/disabled) not verified [I]; step: one in-game look per frame",
    "No check that a new unit has every icon it needs (buy, small, squad, stats name); step: Art check row 'missing icon' per role",
    "vehicle_view ebm runtime unknown, 0 vanilla files [T]; step: test one ebm in a mod",
    "No side marker (icon_tank(<nation>)) writer for a new nation; step: icon-png kind marker 48x48 x3"
  ]
}
