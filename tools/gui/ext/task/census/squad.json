{
  "thing": "squad",
  "game": ["as64", "mowas2"],
  "made": "2026-11-12 wave 0 census; counts from vanilla AS2 + as64 core: squads.set 120 squad lines (macros squad_with1types 50, 2types 45, 3types 18, 4types 7), bot.data.lua Purchases, unit_icon folders",
  "files": [
    "resource/set/multiplayer/units/squads.set ((\"squad_withNtypes\" side(<army>) name(<name>) c(..) g(..) c1(<breed>:<n>) .. b(..) t(..) level(..) cost(..) f(..)))",
    "resource/set/multiplayer/units/<gameType>.set | <gameClass>.set | common.set (only the first one found is read)",
    "resource/set/multiplayer/units/soldiers.set (member declarations)",
    "resource/set/multiplayer/games/<mode>.set (unitLimits, chargeFactors)",
    "resource/interface/scene/unit_icon/<name>(<army>)_00..03.tga, unit_icon_small/<name>(<army>)_00..03.tga",
    "resource/interface/text/desc.lng (desc/squad/<name>(<army>)), info.lng (info/squad/<name>(<army>))",
    "resource/script/multiplayer/bot.data.lua (Purchases per army: {priority, class, unit, min_income, min_team})"
  ],
  "groups": [
    {"id": "id", "name": "Name and army"},
    {"id": "members", "name": "Who is in the squad"},
    {"id": "text", "name": "Name and tooltip text"},
    {"id": "icon", "name": "Icon"},
    {"id": "card", "name": "Buy card: price, wait, place in the panel"},
    {"id": "mode", "name": "Game mode rules"},
    {"id": "bots", "name": "Bots buying it"}
  ],
  "vars": [
    {"key": "squad.name", "where": "squads.set line name(<name>); card name <name>(<army>)", "type": "text", "plain": "The squad's id; with the army it names the buy card, the icon files and the text keys.", "unit": "", "vanilla": {"count": 21, "common": ["riflemans", "smgs", "assault", "engineers", "snipers", "mgunners"]}, "count": 120, "count_of": "squad lines in squads.set", "group": "id", "ref": null, "tool": "gen squad name", "limit": "SDL-30", "tag": "V"},
    {"key": "squad.army", "where": "squads.set line side(<army>)", "type": "choice", "plain": "Which army can buy the squad.", "unit": "", "vanilla": {"values": ["eng", "ger", "ger2", "jap", "rus", "usa"]}, "count": 120, "count_of": "squad lines in squads.set", "group": "id", "ref": "army", "tool": "gen squad army", "limit": "MIS-07", "tag": "V"},
    {"key": "squad.file", "where": "set/multiplayer/units/<gameType>.set, <gameClass>.set or common.set", "type": "choice", "plain": "Which units file the squad is written in; only the first of these files that exists is read.", "unit": "", "vanilla": {"values": ["squads.set (included from the units file)"]}, "count": 1, "group": "id", "ref": null, "tool": "gen squad (writes the mod units file)", "limit": "TST-94", "tag": "V"},

    {"key": "squad.members", "where": "squads.set line c1(<breed>:<n>) .. c4(<breed>:<n>) → {content \"mp/<army>/<breed>:<n> ...\"}", "type": "list", "plain": "The soldier types in the squad and how many of each.", "unit": "", "vanilla": {"common": ["rifle:4 squadleader:1", "smg:5", "engineer:3"]}, "count": 120, "count_of": "squad lines in squads.set", "group": "members", "ref": "soldier", "tool": "gen squad members", "limit": "MIS-75", "tag": "V"},
    {"key": "squad.members.breed", "where": "cN(<breed>:<n>) breed part, read as mp/<army>/<breed>", "type": "ref", "plain": "One member's soldier type; it needs a breed file and a soldier declaration of the same army.", "unit": "", "vanilla": {"common": ["rifle", "smg", "squadleader", "mgun", "sniper"]}, "count": 120, "count_of": "squad lines in squads.set", "group": "members", "ref": "soldier", "tool": "gen squad members", "limit": "MIS-76", "tag": "V"},
    {"key": "squad.members.count", "where": "cN(<breed>:<n>) count part", "type": "number", "plain": "How many of that soldier type.", "unit": "men", "vanilla": {"min": 1, "max": 8, "common": [1, 2, 3, 4]}, "count": 120, "count_of": "squad lines in squads.set", "group": "members", "ref": null, "tool": "gen squad members + /api/x/units/recipe", "limit": null, "tag": "V"},
    {"key": "squad.member_types", "where": "macro name squad_with1types .. squad_with4types", "type": "choice", "plain": "How many different soldier types the squad has; picks which macro writes the line.", "unit": "types", "vanilla": {"values": [1, 2, 3, 4]}, "count": 120, "count_of": "squad lines in squads.set", "group": "members", "ref": "squads.set macro", "tool": "gen squad members (picks the macro)", "limit": "SDL-17", "tag": "V"},
    {"key": "squad.size", "where": "sum of member counts", "type": "number", "plain": "Total men in the squad.", "unit": "men", "vanilla": {"min": 1, "max": 8, "common": [3, 4, 5, 6]}, "count": 120, "count_of": "squad lines in squads.set", "group": "members", "ref": null, "tool": "gen squad members", "limit": null, "tag": "V"},
    {"key": "squad.leader", "where": "first member able to lead, in member order (c1 first)", "type": "ref", "plain": "The squad leader: the first member in the list who can lead.", "unit": "", "vanilla": {"common": ["squadleader", "officer", "rifle"]}, "count": 120, "count_of": "squad lines in squads.set", "group": "members", "ref": "soldier", "tool": "gen squad members (order)", "limit": null, "tag": "I"},
    {"key": "squad.content.raw", "where": "{\"<name>(<army>)\" {content \"<unit>[:count] ( crew ) *\"}} (card written without a macro)", "type": "text", "plain": "The full member text of a card written by hand; it can also put crews in vehicles.", "unit": "", "vanilla": {"common": ["mp/ger/rifle:4 mp/ger/squadleader"]}, "count": 0, "group": "members", "ref": "unit", "tool": null, "limit": "MIS-75", "tag": "V"},

    {"key": "squad.text.name", "where": "interface/text/desc.lng: desc/squad/<name>(<army>)", "type": "text", "plain": "The squad's name shown on the buy card, in every language of the mod.", "unit": "", "vanilla": {"common": ["Riflemen", "Assault squad"]}, "count": 120, "group": "text", "ref": "localization key", "tool": "gen squad display", "limit": "LOC-02", "tag": "V"},
    {"key": "squad.text.info", "where": "interface/text/info.lng: info/squad/<info or name>(<army>)", "type": "text", "plain": "The tooltip text of the buy card.", "unit": "", "vanilla": {"common": ["Basic infantry squad"]}, "count": 120, "group": "text", "ref": "localization key", "tool": "gen squad info", "limit": "LOC-02", "tag": "V"},
    {"key": "squad.card.info", "where": "card > {info \"<key>\"}", "type": "text", "plain": "Use another squad's tooltip key instead of its own.", "unit": "", "vanilla": {"values": []}, "count": 0, "group": "text", "ref": "localization key", "tool": null, "limit": null, "tag": "V"},

    {"key": "squad.icon.unit_icon", "where": "interface/scene/unit_icon/<name>(<army>)_00..03.tga (4 frames)", "type": "file", "plain": "The big buy card picture, four frames; a stub shows when it is missing.", "unit": "px", "vanilla": {"common": ["128x128"]}, "count": 120, "group": "icon", "ref": "image (.tga)", "tool": "/api/x/art/icon-png kind icon", "limit": "UI-03", "tag": "V"},
    {"key": "squad.icon.small", "where": "interface/scene/unit_icon_small/<name>(<army>)_00..03.tga", "type": "file", "plain": "The small buy card picture, four frames.", "unit": "px", "vanilla": {"common": ["64x64"]}, "count": 120, "group": "icon", "ref": "image (.tga)", "tool": "/api/x/art/icon-png kind icon", "limit": "UI-03", "tag": "V"},
    {"key": "squad.card.icon", "where": "card > {icon n}", "type": "number", "plain": "Frame number in the icon picture strip (integer).", "unit": "index", "vanilla": {"values": []}, "count": 0, "group": "icon", "ref": null, "tool": null, "limit": "SDL-30", "tag": "V"},
    {"key": "squad.icon.bar", "where": "breed icon_priority of members → interface/scene/squad/<icon>.tga", "type": "ref", "plain": "The squad bar icon in game comes from the member with the highest icon priority.", "unit": "", "vanilla": {"common": ["squadleader", "rifleman"]}, "count": 120, "group": "icon", "ref": "soldier breed.icon_priority", "tool": "gen breed set:icon_priority", "limit": null, "tag": "I"},

    {"key": "squad.card.cost", "where": "squads.set line cost(n) → {cost n}", "type": "number", "plain": "Price in requisition points.", "unit": "points", "vanilla": {"min": 10, "max": 340, "common": [40, 60, 80, 100, 120]}, "count": 120, "count_of": "squad lines in squads.set", "group": "card", "ref": null, "tool": "gen squad fields.cost + /api/x/units/change cost", "limit": null, "tag": "V"},
    {"key": "squad.card.charge", "where": "squads.set line c(n) → {charge n}", "type": "number", "plain": "Wait after buying before the card can be bought again (whole seconds).", "unit": "s", "vanilla": {"values": [0, 15, 30, 60, 120, 150, 300]}, "count": 120, "count_of": "squad lines in squads.set", "group": "card", "ref": null, "tool": "gen squad fields.c + /api/x/units/change charge", "limit": "SDL-30", "tag": "V"},
    {"key": "squad.card.fore", "where": "squads.set line f(n) → {fore n}", "type": "number", "plain": "How charged the card is at game start (1 ready, 0 empty, -1 one extra wait).", "unit": "fraction", "vanilla": {"values": [-1, 0, 1]}, "count": 120, "count_of": "squad lines in squads.set", "group": "card", "ref": null, "tool": "gen squad fields.f + /api/x/units/change fore", "limit": null, "tag": "V"},
    {"key": "squad.card.group", "where": "squads.set line g(<group>) → {group}", "type": "choice", "plain": "Cards in the same group share their wait: buying one restarts the others.", "unit": "", "vanilla": {"values": ["squad_1", "squad_2", "squad_3", "squad_4", "squad_5", "squad_6", "squad_7", "squad_8", "squad_9", "soldier_1", "soldier_2", "soldier_3", "soldier_4", "soldier_5", "soldier_6", "soldier_7", "soldier_8", "soldier_9", "soldier_10"]}, "count": 120, "count_of": "squad lines in squads.set", "group": "card", "ref": null, "tool": "gen squad fields.g", "limit": null, "tag": "V"},
    {"key": "squad.card.button", "where": "squads.set line b(<button>) → {button}", "type": "choice", "plain": "Which buy panel tab and budget the card sits in.", "unit": "", "vanilla": {"values": ["squad1", "squad2"]}, "count": 120, "count_of": "squad lines in squads.set", "group": "card", "ref": null, "tool": "gen squad fields.b", "limit": null, "tag": "V"},
    {"key": "squad.card.tags", "where": "squads.set line t(<tags>) → {tags \"frontline_cp infantry <army> <t>\"}", "type": "list", "plain": "Words game modes and limits use to find the squad (infantry, engineers, sniper_only ...).", "unit": "", "vanilla": {"values": ["all inf_only", "engineers", "mines", "single", "tankmans", "flamer", "sniper_only", "officer"]}, "count": 120, "count_of": "squad lines in squads.set", "group": "card", "ref": null, "tool": "gen squad fields.t", "limit": "MIS-04", "tag": "V"},
    {"key": "squad.card.level", "where": "squads.set line level(n) → {level n}", "type": "number", "plain": "Rank (stage) the player must reach before the card unlocks.", "unit": "level", "vanilla": {"min": 1, "max": 21, "common": [1, 2, 3, 5]}, "count": 120, "count_of": "squad lines in squads.set", "group": "card", "ref": null, "tool": "gen squad fields.level + /api/x/units/change level", "limit": "MIS-15", "tag": "V"},
    {"key": "squad.card.order", "where": "card > {order n}", "type": "number", "plain": "Position of the card in its panel (integer).", "unit": "index", "vanilla": {"values": []}, "count": 0, "group": "card", "ref": null, "tool": null, "limit": "SDL-30", "tag": "V"},
    {"key": "squad.card.not_for_sale", "where": "card > {not_for_sale}", "type": "bool", "plain": "The card exists for missions and scripts but is not shown in the buy panel.", "unit": "", "vanilla": {"values": []}, "count": 0, "group": "card", "ref": null, "tool": null, "limit": null, "tag": "V"},
    {"key": "squad.card.remove", "where": "card > {remove}", "type": "bool", "plain": "Takes a card out (used by a mod to remove a vanilla squad).", "unit": "", "vanilla": {"values": []}, "count": 0, "group": "card", "ref": null, "tool": null, "limit": "TST-94", "tag": "V"},
    {"key": "squad.card.basic", "where": "card > {basic}", "type": "bool", "plain": "Keeps the card when a game mode removes units.", "unit": "", "vanilla": {"values": []}, "count": 0, "group": "card", "ref": null, "tool": null, "limit": null, "tag": "I"},
    {"key": "squad.card.cp", "where": "sum of member declarations' {cp} (soldiers.set); a card {cp} overrides", "type": "number", "plain": "Command points the squad uses; by default the sum of its members.", "unit": "points", "vanilla": {"min": 0.25, "max": 40, "common": [10, 12.5, 15]}, "count": 120, "count_of": "squad lines (computed)", "group": "card", "ref": "soldier card.cp", "tool": "gen breed decl:cp (per member)", "limit": null, "tag": "V"},
    {"key": "squad.card.score", "where": "sum of member declarations' {score}; a card {score} overrides", "type": "number", "plain": "Score the enemy gets for killing the whole squad.", "unit": "points", "vanilla": {"min": 0.25, "max": 40, "common": [1.25, 2.5]}, "count": 120, "count_of": "squad lines (computed)", "group": "card", "ref": "soldier card.score", "tool": "gen breed decl:score (per member)", "limit": null, "tag": "V"},
    {"key": "squad.card.cw", "where": "card > {cw f} or members' declarations", "type": "number", "plain": "How strongly the squad captures flags.", "unit": "x", "vanilla": {"min": 0.25, "max": 10, "common": [1]}, "count": 120, "count_of": "squad lines (computed)", "group": "card", "ref": "soldier card.cw", "tool": "gen breed decl:cw (per member)", "limit": null, "tag": "I"},

    {"key": "squad.mode.limit", "where": "set/multiplayer/games/<mode>.set > {unitLimits {\"<tag>\" n}}", "type": "number", "plain": "How many squads with a given tag a player may have at once in a game mode.", "unit": "squads", "vanilla": {"common": ["sniper_only 1", "officer 1"]}, "count": 0, "group": "mode", "ref": "card tags", "tool": null, "limit": "MIS-04", "tag": "I"},
    {"key": "squad.mode.charge_factor", "where": "set/multiplayer/games/<mode>.set > {chargeFactors}", "type": "number", "plain": "A game mode's multiplier on card waits.", "unit": "x", "vanilla": {"common": [1]}, "count": 0, "group": "mode", "ref": null, "tool": null, "limit": null, "tag": "T"},

    {"key": "squad.bots.buy", "where": "script/multiplayer/bot.data.lua Purchases[<army>] entry with unit = \"<name>(<army>)\"", "type": "bool", "plain": "Computer players can buy the squad.", "unit": "", "vanilla": {"values": [true, false]}, "count": 818, "count_of": "Purchases entries (all unit kinds)", "group": "bots", "ref": null, "tool": "gen squad bots", "limit": "MIS-79", "tag": "V"},
    {"key": "squad.bots.priority", "where": "Purchases entry {priority = f}", "type": "number", "plain": "How often bots pick it compared with other cards.", "unit": "weight", "vanilla": {"values": [0.5, 1.0, 3.0]}, "count": 818, "count_of": "Purchases entries", "group": "bots", "ref": null, "tool": "gen squad bots: <priority>", "limit": "MIS-80", "tag": "V"},
    {"key": "squad.bots.class", "where": "Purchases entry {class = UnitClass.X}", "type": "choice", "plain": "What bots think the card is for.", "unit": "", "vanilla": {"values": ["Infantry", "ATInfantry", "Tank", "ATTank", "HeavyTank", "AATank", "ArtilleryTank", "Vehicle"]}, "count": 818, "count_of": "Purchases entries", "group": "bots", "ref": null, "tool": null, "limit": "MIS-83", "tag": "V"},
    {"key": "squad.bots.min_income", "where": "Purchases entry {min_income = f}", "type": "number", "plain": "Bots buy it only once their income is at least this.", "unit": "points/s", "vanilla": {"min": 0, "max": 3.5}, "count": 180, "count_of": "Purchases entries", "group": "bots", "ref": null, "tool": null, "limit": "MIS-84", "tag": "V"},
    {"key": "squad.bots.min_team", "where": "Purchases entry {min_team = n}", "type": "number", "plain": "Bots buy it only in teams of at least this many players.", "unit": "players", "vanilla": {"values": [2, 3, 4]}, "count": 66, "count_of": "Purchases entries", "group": "bots", "ref": null, "tool": null, "limit": "MIS-84", "tag": "V"}
  ],
  "gaps": [
    "members: more than 4 soldier types needs a hand written card (no squad_with5types macro): gen squad writes an expanded {\"<name>(<army>)\" {content ...}} block when members > 4 types",
    "members: squad.content.raw (crews in vehicles, hand written content) has no writer: same expanded-card mode in gen squad (`content` field)",
    "card: order, icon, not_for_sale, remove, basic, info are not macro args, so gen squad fields cannot set them: gen squad `card: {order, not_for_sale, ...}` appended after the macro call or in expanded mode",
    "card: removing a vanilla squad (remove) has no op: gen op `unremove`/`remove-card` {name, army} writing {\"<name>(<army>)\" {remove}}",
    "bots: class, min_income, min_team are copied from the like squad only: gen squad `bots: {priority, class, min_income, min_team}` object form",
    "mode: unitLimits and chargeFactors per game mode have no writer: gen op `mode-limit` {mode, tag, n}",
    "icon: squad bar icon is derived from member icon_priority; no squad-side choice (document, no op)",
    "text: card.info (shared tooltip key) not settable: part of the gen squad `card` map"
  ]
}
