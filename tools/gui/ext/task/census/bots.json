  "buy.min_income/min_team: no step; add body.minIncome, body.minTeam to POST /api/x/bots/buyfirst",
  "buy.stage_repeat: no step; add POST /api/x/bots/stage {army, stage, repeat}",
  "buy.remove (remove/reorder entries): no step; add botrecipe --remove <unit> and a route",
  "mind.maxsquadsize/orderrotation/flagpriority: only via a persona; add a doctrine \"raw\" override map to POST gen",
  "mind.per_army: one persona per mod; add body.army to doctrine gen writing per-army tables",
  "on.enablebots without cloning a map: none; add POST /api/x/bots/enable {mod, mode}",
  "level.chargefactors: no tool; add to bots table fields",
  "buy.team_mode/stock: botrecipe flags not in the route; add body fields"
 ]
