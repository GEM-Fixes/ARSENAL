    { "key": "wav.seconds", "where": "WAV data length", "type": "number", "plain": "Length", "unit": "s", "vanilla": { "min": 0, "max": 220.7, "common": 1.62 }, "count": 4978, "group": "wav", "ref": "", "tool": "tools/sound/sound.js info", "limit": "", "tag": "V" },
    { "key": "wav.folder_pick", "where": "name points to a folder", "type": "ref", "plain": "A folder name plays a random file from a shuffle bag", "unit": "files", "vanilla": { "min": 1, "max": 155, "common": 5 }, "count": 561, "group": "wav", "ref": "", "tool": "tools/sound/sound.js resolve", "limit": "VIS-08", "tag": "V" },
    { "key": "wav.copies", "where": "engine", "type": "number", "plain": "At most 3 copies of one file at once; a repeat within 50 ms is dropped", "unit": "", "vanilla": { "values": ["3", "50 ms"] }, "count": 0, "group": "wav", "ref": "", "tool": "", "limit": "VIS-10", "tag": "V" },
