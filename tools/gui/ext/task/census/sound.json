    { "key": "vehicle.script_sound", "where": "start_sound path [ambient], play_sound slot [loop], stop_sound slot", "type": "text", "plain": "Script sound actions", "unit": "", "vanilla": { "values": ["23 files"] }, "count": 23, "group": "vehicle", "ref": "wav.file", "tool": "", "limit": "", "tag": "V" },
    { "key": "world.fx_sound", "where": "entity/fx/** def {sound \"x\"}", "type": "ref", "plain": "Sound of an effect (blast, fire)", "unit": "", "vanilla": { "values": ["107 fx defs"] }, "count": 107, "group": "world", "ref": "wav.file", "tool": "", "limit": "", "tag": "V" },
    { "key": "world.speaker", "where": "{extender \"speaker\" {soundName}{cycleTime a b}{recoveryTime a b}{signalDepend \"shot explosion movement\"}}", "type": "list", "plain": "Placed ambient speaker", "unit": "s", "vanilla": { "values": ["27 service/sound defs"] }, "count": 27, "group": "world", "ref": "wav.file", "tool": "", "limit": "", "tag": "V" },
    { "key": "world.thunder", "where": "environment {sound}", "type": "ref", "plain": "Thunder sound", "unit": "", "vanilla": { "values": [] }, "count": 0, "group": "world", "ref": "wav.file", "tool": "", "limit": "", "tag": "I" },
    { "key": "voice.breed", "where": "breed {voice \"x\"} / {nationality}", "type": "ref", "plain": "Speech set for a soldier, under sound/human", "unit": "", "vanilla": { "values": [] }, "count": 286, "group": "voice", "ref": "wav.file", "tool": "gen breed", "limit": "", "tag": "I" }
  ],
  "gaps": [
    "No folder.set writer (Tag/Loudness/Distance/Volume/Signal/SignalPeriod); step: tools/sound model.js write() + /art/sound-folder route",
    "No sound.set loudness row add (must copy whole file and keep default); step: route that copies vanilla sound.set into the mod and appends one row",
    "No wav convert route though lib/wav has encodePcm16/encodeImaAdpcm; step: /art/wav-convert mono 44100 IMA 1024/2041 from PCM wav",
    "fireSound/reloadSound only via gen set; step: Art sound card 'set' button writing the stuff key",
    "No link_sound slot editor for vehicles; step: route that writes a sound tag macro copy in tank.inc/car.inc pattern",
    "No speaker extender or FX {sound} writer; step: gen op speaker",
    "folder.set Distance keys unused in vanilla, effect unverified [T]; step: in-game test",
    "Voice key mapping to sound/human folders not traced [I]; step: q.js on breed voice + one test",
    "No check that a referenced sound name resolves (would show 'unknown sound file' only in log); step: lint row via sound.js resolve over mod sets"
  ]
}
