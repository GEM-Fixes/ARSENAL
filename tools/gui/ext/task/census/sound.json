    { "key": "mix.loudness", "where": "sound/sound.set loudness rows: name min max [priority]", "type": "list", "plain": "Named loudness: distance range and priority", "unit": "m", "vanilla": { "values": ["default 20 0", "footstep 10 250 0", "shoot normal 10 0 20", "shoot loud 35 0 30", "blast big 50 0 40", "canonade 400 0", "air attack 300 0", "talk 30 500"] }, "count": 19, "group": "mix", "ref": "", "tool": "", "limit": "VIS-27 (must keep default)", "tag": "V" },
    { "key": "weapon.fire_sound", "where": "set/stuff/** {fireSound \"x\"} → sound/weapon/shot/<x>", "type": "ref", "plain": "Shot sound", "unit": "", "vanilla": { "values": ["192 set files"] }, "count": 192, "group": "weapon", "ref": "wav.file", "tool": "Art: /art/sound?weapon (find); gen set (write)", "limit": "an unknown name logs 'unknown sound file'", "tag": "V" },
    { "key": "weapon.reload_sound", "where": "{reloadSound \"x\"} → sound/weapon/reload/<x>", "type": "ref", "plain": "Reload sound", "unit": "", "vanilla": { "values": ["147 set files"] }, "count": 147, "group": "weapon", "ref": "wav.file", "tool": "Art: /art/sound?weapon (find); gen set (write)", "limit": "", "tag": "V" },
