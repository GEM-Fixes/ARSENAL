    { "key": "wav.codec", "where": "WAV fmt chunk", "type": "choice", "plain": "Encoding", "unit": "", "vanilla": { "values": ["IMA ADPCM 4294", "PCM16 677", "PCM8 5"] }, "count": 4978, "group": "wav", "ref": "", "tool": "tools/lib/wav.js parse", "limit": "FMT-14 (.ogg/.mp3 ignored)", "tag": "V" },
    { "key": "wav.channels", "where": "WAV fmt chunk", "type": "choice", "plain": "Mono or stereo (mono for 3D sounds)", "unit": "", "vanilla": { "values": ["mono 4757", "stereo 213"] }, "count": 4978, "group": "wav", "ref": "", "tool": "tools/lib/wav.js", "limit": "", "tag": "V" },
    { "key": "wav.rate", "where": "WAV fmt chunk", "type": "choice", "plain": "Sample rate", "unit": "Hz", "vanilla": { "values": ["44100", "22050"], "common": 44100 }, "count": 4978, "group": "wav", "ref": "", "tool": "tools/lib/wav.js", "limit": "", "tag": "V" },
