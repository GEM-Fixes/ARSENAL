{
  "thing": "soldier",
  "game": ["as64", "mowas2"],
  "made": "2026-11-12 wave 0 census; counts from a vfs walk of vanilla AS2 + as64 core (292 files under set/breed: 275 mp breeds, 6 veterancy .inc, 5 civilian, 6 special; 134 humanskin def+mtl; 83 equipment defs; soldiers.set 260 declarations)",
  "files": [
    "resource/set/breed/mp/<army>/<name>.set (multiplayer breed; army = eng ger ger2 jap rus usa)",
    "resource/set/breed/<folder>/<name>.set (single player, civilian, special; subfolders allowed, breed name = file title)",
    "resource/set/breed/mp/<army>/veterancy_generic.inc (veterancy macro)",
    "resource/set/multiplayer/units/soldiers.set ({\"mp/<army>/<name>\" ...} soldier declaration)",
    "resource/set/multiplayer/units/squads.set (squads that use the breed)",
    "resource/entity/humanskin/<skin>/<skin>.def, <skin>.mdl, skin.mtl, skin*.ply, <skin>.dds, <skin>#d.dds, <skin>#1.dds, <skin>_bp.dds, <skin>_sp.dds",
    "resource/entity/inventory/-equipment/head/<item>/ and -equipment/body/<item>/ (helmets, caps, body armour)",
    "resource/interface/scene/portrait/<portrait>.tga",
    "resource/interface/scene/unit_icon/<icon>(<nationality>)_00..03.tga, unit_icon_small/<icon>(<nationality>)_00..03.tga, interface/scene/squad/<icon>.tga",
    "resource/interface/text/desc.lng (desc/human/mp/<army>/<name>), names/<nationality>/first|last",
    "resource/set/talk.set + resource/sound/human/talk/<voice>/ (voice, see census voice.json)",
    "shared by every soldier: resource/properties/human.ext, resource/entity/-human/human.def, resource/set/ability/*.set"
  ],
  "groups": [
    {"id": "id", "name": "Name, army and kind"},
    {"id": "look", "name": "Body and skin (uniform, helmet)"},
    {"id": "face", "name": "Portrait and icons"},
    {"id": "voice", "name": "Voice"},
    {"id": "kit", "name": "Weapons and equipment carried"},
    {"id": "body", "name": "Health, stamina and speed"},
    {"id": "skill", "name": "Weapon skills, crew skills and rank"},
    {"id": "sight", "name": "Sight"},
    {"id": "perks", "name": "Special abilities"},
    {"id": "text", "name": "Name text"},
    {"id": "card", "name": "Multiplayer soldier declaration"},
    {"id": "squads", "name": "Squads that use it"},
    {"id": "shared", "name": "Shared by every soldier (advanced)"}
  ],
  "vars": [
    {"key": "breed.name", "where": "set/breed/mp/<army>/<name>.set: file title", "type": "text", "plain": "The soldier type's id: the file name of his breed, used by squads and missions.", "unit": "", "vanilla": {"common": ["rifle", "smg", "squadleader", "mgun", "sniper", "tankman"]}, "count": 286, "group": "id", "ref": null, "tool": "gen breed name", "limit": "HUM-18", "tag": "V"},
    {"key": "breed.army", "where": "set/breed/mp/<army>/ folder; soldiers.set mp/<army>/<name>", "type": "choice", "plain": "Which army the soldier belongs to; it also decides which army's buy panel can use him.", "unit": "", "vanilla": {"values": ["eng", "ger", "ger2", "jap", "rus", "usa"]}, "count": 275, "group": "id", "ref": "army", "tool": "gen breed army", "limit": null, "tag": "V"},
    {"key": "breed.behaviour", "where": "{breed} > {behaviour}", "type": "choice", "plain": "How he acts with no order: as a soldier or as a civilian.", "unit": "", "vanilla": {"values": ["soldier", "civilian"]}, "count": 6, "group": "id", "ref": null, "tool": "gen breed set:behaviour", "limit": null, "tag": "V"},
    {"key": "breed.hero", "where": "{breed} > {hero}", "type": "bool", "plain": "Marks a named hero; the unit bar then shows no description text for him.", "unit": "", "vanilla": {"values": [true, false]}, "count": 16, "group": "id", "ref": null, "tool": "gen breed set:+hero", "limit": null, "tag": "V"},
    {"key": "breed.tags", "where": "{breed} > {tags}", "type": "list", "plain": "Labels for scripts and missions; only kamikaze changes how the game treats him.", "unit": "", "vanilla": {"values": ["officer", "stealth"], "engine": ["kamikaze"]}, "count": 14, "group": "id", "ref": null, "tool": "gen breed set:tags", "limit": "HUM-19", "tag": "V"},
    {"key": "breed.nationality", "where": "{breed} > {nationality}", "type": "choice", "plain": "His nation: picks the list his random names come from, his default voice and the side version of his icon.", "unit": "", "vanilla": {"values": ["eng", "ger", "ger2", "jap", "rus", "usa"]}, "count": 286, "group": "id", "ref": "names/<nationality>, voice", "tool": "gen breed set:nationality", "limit": null, "tag": "V"},

    {"key": "breed.skin", "where": "{breed} > {skin}", "type": "ref", "plain": "The body model and uniform he wears (a folder in entity/humanskin).", "unit": "", "vanilla": {"count": 63, "common": ["ger_t2", "ger_com", "rus_t2", "eng_t2", "us_t2"]}, "count": 286, "group": "look", "ref": "humanskin", "tool": "gen breed set:skin", "limit": null, "tag": "V"},
    {"key": "humanskin.def.extension", "where": "entity/humanskin/<skin>/<skin>.def > {game_entity} > {Extension}", "type": "file", "plain": "The model file (.mdl) of the skin.", "unit": "", "vanilla": {"common": ["<skin>.mdl"]}, "count": 66, "group": "look", "ref": "model (.mdl)", "tool": "/api/x/art/copy", "limit": null, "tag": "V"},
    {"key": "humanskin.def.tag", "where": "<skin>.def > {game_entity} > {tag}", "type": "list", "plain": "Words that describe the skin (nation, soldier or officer).", "unit": "", "vanilla": {"values": ["ger soldier", "ger2 soldier", "rus soldier", "usa officer", "usa soldier", "worker"]}, "count": 19, "group": "look", "ref": null, "tool": null, "limit": null, "tag": "V"},
    {"key": "humanskin.def.rimlight", "where": "<skin>.def > {game_entity} > {RimLight}", "type": "bool", "plain": "Draws a thin light edge around the soldier so he stands out.", "unit": "", "vanilla": {"values": [true, false]}, "count": 39, "group": "look", "ref": null, "tool": null, "limit": null, "tag": "V"},
    {"key": "humanskin.def.texmod", "where": "<skin>.def > {game_entity} > {texmod}", "type": "choice", "plain": "A texture variant name (camouflage set) used by this skin.", "unit": "", "vanilla": {"values": ["camo", "jager", "stosstrupp"]}, "count": 3, "group": "look", "ref": "texture variant (#1 #2 #d)", "tool": "/api/x/art/camo-write", "limit": null, "tag": "I"},
    {"key": "humanskin.mtl.kind", "where": "<skin>/skin.mtl > {material <kind>}", "type": "choice", "plain": "Material type of the uniform: with a bump map or plain.", "unit": "", "vanilla": {"values": ["bump", "simple"]}, "count": 67, "group": "look", "ref": null, "tool": null, "limit": null, "tag": "V"},
    {"key": "humanskin.mtl.diffuse", "where": "skin.mtl > {material} > {diffuse}", "type": "file", "plain": "The colour picture of the uniform (the main texture).", "unit": "", "vanilla": {"common": ["<skin>"]}, "count": 67, "group": "look", "ref": "texture (.dds)", "tool": "/api/x/art/copy", "limit": null, "tag": "V"},
    {"key": "humanskin.mtl.bump", "where": "skin.mtl > {material} > {bump}", "type": "file", "plain": "The bump picture that gives the cloth its folds.", "unit": "", "vanilla": {"common": ["<skin>_bp", "<skin>_nm"]}, "count": 59, "group": "look", "ref": "texture (.dds)", "tool": "/api/x/art/copy", "limit": null, "tag": "V"},
    {"key": "humanskin.mtl.specular", "where": "skin.mtl > {material} > {specular}", "type": "file", "plain": "The shine picture of the uniform.", "unit": "", "vanilla": {"common": ["<skin>_sp"]}, "count": 65, "group": "look", "ref": "texture (.dds)", "tool": "/api/x/art/copy", "limit": null, "tag": "V"},
    {"key": "humanskin.mtl.color", "where": "skin.mtl > {material} > {color}", "type": "text", "plain": "Tint and gloss of the uniform: red green blue gloss.", "unit": "", "vanilla": {"values": ["230 230 230 25", "229 229 229 25"]}, "count": 65, "group": "look", "ref": null, "tool": null, "limit": null, "tag": "V"},
    {"key": "humanskin.mtl.blend", "where": "skin.mtl > {material} > {blend}", "type": "choice", "plain": "How see-through parts are drawn; uniforms use none.", "unit": "", "vanilla": {"values": ["none", "test", "blend"]}, "count": 67, "group": "look", "ref": null, "tool": null, "limit": null, "tag": "V"},
    {"key": "humanskin.mtl.tile", "where": "skin.mtl > {material} > {tile}", "type": "bool", "plain": "Repeats the texture across the model.", "unit": "", "vanilla": {"values": [true, false]}, "count": 6, "group": "look", "ref": null, "tool": null, "limit": null, "tag": "V"},
    {"key": "humanskin.texture.files", "where": "entity/humanskin/<skin>/<skin>.dds, <skin>#d.dds, <skin>#1.dds, <skin>_bp.dds, <skin>_sp.dds", "type": "file", "plain": "The picture files of the uniform; #1, #2 and #d are season or camouflage variants picked by the map.", "unit": "", "vanilla": {"common": ["<skin>.dds", "<skin>#d.dds", "<skin>#1.dds", "<skin>_bp.dds", "<skin>_sp.dds"]}, "count": 304, "group": "look", "ref": "texture (.dds)", "tool": "/api/x/art/copy", "limit": null, "tag": "V"},
    {"key": "humanskin.mesh", "where": "<skin>.mdl > {bone \"skin\"} > {LODView {VolumeView \"skin.ply\"} ...}; skin.ply skin_lod1.ply skin_lod2.ply", "type": "file", "plain": "The 3D body mesh and its two lower detail copies.", "unit": "", "vanilla": {"common": ["skin.ply", "skin_lod1.ply", "skin_lod2.ply"]}, "count": 65, "group": "look", "ref": "model (.ply)", "tool": null, "limit": "PORT-185", "tag": "V"},
    {"key": "humanskin.skeleton", "where": "<skin>.mdl > {Skeleton} bone tree", "type": "file", "plain": "The bones of the body; they must match the shared soldier skeleton because animations play on human.mdl.", "unit": "", "vanilla": {"common": ["38-bone set", "9 distinct bone sets over 67 mdl"]}, "count": 65, "group": "look", "ref": "skeleton", "tool": null, "limit": "PORT-185", "tag": "V"},
    {"key": "breed.armors.head", "where": "{breed} > {armors} > {head}", "type": "ref", "plain": "The helmet or cap he wears (an item from entity/inventory/-equipment/head).", "unit": "", "vanilla": {"count": 58, "common": ["helmet1_ger", "fieldcap_ger", "helmet1_rus", "helmet1_usa", "helmet1_eng"]}, "count": 281, "group": "look", "ref": "equipment item (head)", "tool": "gen breed set:armors/head", "limit": "HUM-22", "tag": "V"},
    {"key": "breed.armors.body", "where": "{breed} > {armors} > {body}", "type": "ref", "plain": "Body armour or a worn charge (an item from entity/inventory/-equipment/body).", "unit": "", "vanilla": {"values": ["body_armor", "kamikaze_bomb"]}, "count": 4, "group": "look", "ref": "equipment item (body)", "tool": "gen breed set:+armors/body", "limit": "HUM-22", "tag": "V"},

    {"key": "breed.portrait", "where": "{breed} > {portrait}", "type": "ref", "plain": "The face picture shown in the unit panel.", "unit": "", "vanilla": {"count": 81, "common": ["ger_soldier2", "ger_soldier3", "eng_soldier2", "none"]}, "count": 286, "group": "face", "ref": "image interface/scene/portrait/<name>.tga", "tool": "gen breed set:portrait + /api/x/art/icon-png kind portrait", "limit": "UI-03", "tag": "V"},
    {"key": "breed.icon", "where": "{breed} > {icon}", "type": "ref", "plain": "The small picture name for him in squad and unit lists; the side version <icon>(<nationality>) is looked up.", "unit": "", "vanilla": {"count": 50, "common": ["rifleman", "smg", "squadleader", "mg", "sniper", "officer"]}, "count": 286, "group": "face", "ref": "image interface/scene/unit_icon/<icon>(<nationality>)", "tool": "gen breed set:icon", "limit": "UI-03", "tag": "V"},
    {"key": "breed.icon_priority", "where": "{breed} > {icon_priority}", "type": "number", "plain": "In a squad, the member with the highest number gives the squad bar its icon.", "unit": "", "vanilla": {"min": 0, "max": 10, "common": [1, 2, 3]}, "count": 286, "group": "face", "ref": null, "tool": "gen breed set:icon_priority", "limit": null, "tag": "V"},
    {"key": "icon.unit_icon", "where": "interface/scene/unit_icon/<icon>(<nationality>)_00..03.tga (4 frames: idle, hover, press, disabled)", "type": "file", "plain": "The big icon picture, four frames.", "unit": "px", "vanilla": {"common": ["128x128"]}, "count": 260, "group": "face", "ref": "image (.tga)", "tool": "/api/x/art/icon-png kind icon", "limit": "UI-03", "tag": "I"},
    {"key": "icon.unit_icon_small", "where": "interface/scene/unit_icon_small/<icon>(<nationality>)_00..03.tga", "type": "file", "plain": "The small icon picture, four frames.", "unit": "px", "vanilla": {"common": ["64x64"]}, "count": 260, "group": "face", "ref": "image (.tga)", "tool": "/api/x/art/icon-png kind icon", "limit": "UI-03", "tag": "I"},
    {"key": "icon.squad_panel", "where": "interface/scene/squad/<icon>.tga", "type": "file", "plain": "The icon in the squad bar at the side of the screen.", "unit": "px", "vanilla": {"common": ["bazooker.tga", "cannon.tga"]}, "count": 438, "group": "face", "ref": "image (.tga)", "tool": null, "limit": "UI-03", "tag": "I"},

    {"key": "breed.voice", "where": "{breed} > {voice}", "type": "ref", "plain": "The voice set he speaks with; when empty he speaks with his nationality's voice.", "unit": "", "vanilla": {"values": ["(absent: nationality)", "rus", "ger", "ger2", "eng", "usa", "jap"]}, "count": 0, "group": "voice", "ref": "voice (talk.set phrase language)", "tool": "gen breed set:+voice", "limit": null, "tag": "V"},

    {"key": "breed.inventory.item", "where": "{breed} > {inventory} > {item \"tags\" [n [dev]] [filled [N] | filling \"tags\" N]} (one line per thing, in order)", "type": "list", "plain": "The things he starts with: guns, ammunition, grenades, bandages, tools; one line each, placed in his box in order.", "unit": "", "vanilla": {"count": 211, "common": ["mauzer filled", "mp40 filled", "ammo rifle 100", "ammo pistol 500", "bandage 3", "grenade m24 1"]}, "count": 281, "group": "kit", "ref": "stuff (weapon, ammo, grenade, item)", "tool": "gen breed set:inventory/item[n] and set:+inventory/item", "limit": "HUM-21", "tag": "V"},
    {"key": "breed.inventory.item.tags", "where": "{item \"tags\" ...} first value", "type": "ref", "plain": "Which thing: the item that carries all these words.", "unit": "", "vanilla": {"common": ["mp40", "mauzer", "ammo rifle", "ammo pistol", "bandage", "grenade m24"]}, "count": 281, "group": "kit", "ref": "stuff tags", "tool": "gen breed set:inventory/item[n]", "limit": null, "tag": "V"},
    {"key": "breed.inventory.item.count", "where": "{item \"tags\" n}", "type": "number", "plain": "How many; for ammunition it is rounds.", "unit": "pieces or rounds", "vanilla": {"min": 1, "max": 500, "common": [1, 2, 3, 50, 100, 200, 500]}, "count": 281, "group": "kit", "ref": null, "tool": "gen breed set:inventory/item[n]", "limit": "HUM-23", "tag": "V"},
    {"key": "breed.inventory.item.dev", "where": "{item \"tags\" n dev}", "type": "number", "plain": "A random spread on the count: plus or minus up to this many.", "unit": "pieces", "vanilla": {"common": [1]}, "count": 0, "group": "kit", "ref": null, "tool": "gen breed set:inventory/item[n]", "limit": null, "tag": "V"},
    {"key": "breed.inventory.item.filled", "where": "{item \"tags\" filled}", "type": "bool", "plain": "The gun starts with a full magazine.", "unit": "", "vanilla": {"values": [true, false]}, "count": 281, "group": "kit", "ref": null, "tool": "gen breed set:inventory/item[n]", "limit": null, "tag": "V"},
    {"key": "breed.inventory.item.filled_n", "where": "{item \"tags\" filled N}", "type": "number", "plain": "Load N rounds; this also changes the magazine size of that gun for every soldier.", "unit": "rounds", "vanilla": {"values": []}, "count": 0, "group": "kit", "ref": null, "tool": "gen breed set:inventory/item[n]", "limit": "HUM-20", "tag": "V"},
    {"key": "breed.inventory.item.filling", "where": "{item \"tags\" filling \"tags\" N}", "type": "text", "plain": "Fill the item with N of another thing, for example fuel in a flame thrower tank.", "unit": "", "vanilla": {"common": ["fuel 80"]}, "count": 0, "group": "kit", "ref": "stuff tags", "tool": "gen breed set:inventory/item[n]", "limit": null, "tag": "I"},
    {"key": "breed.inventory.in_hands", "where": "{breed} > {inventory} > {in_hands}", "type": "number", "plain": "Which line he holds in his hands at the start (0 = first item line).", "unit": "index", "vanilla": {"values": [0]}, "count": 279, "group": "kit", "ref": null, "tool": "gen breed set:inventory/in_hands", "limit": "HUM-21", "tag": "V"},

    {"key": "breed.perks.health", "where": "{breed} > {perks} > {\"health\" \"<level>\"}", "type": "choice", "plain": "Health compared with a normal soldier, as a level name.", "unit": "%", "vanilla": {"values": ["100%", "150%", "175%", "200%", "225%", "250%", "275%", "300%", "350%", "500%"], "allowed": ["20%", "30%", "50%", "75%", "100%", "125%", "150%", "175%", "200%", "225%", "250%", "275%", "300%", "350%", "400%", "500%", "600%", "750%", "1000%"]}, "count": 285, "group": "body", "ref": "ability health levels", "tool": "gen breed set:perks/health", "limit": "GPL-13", "tag": "V"},
