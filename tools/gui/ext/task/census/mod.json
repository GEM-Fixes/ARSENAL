  {
   "id": "make",
   "name": "Make the mod"
  },
  {
   "id": "info",
   "name": "mod.info"
  },
  {
   "id": "layout",
   "name": "Files"
  },
  {
   "id": "active",
   "name": "Turn on in the game"
  },
  {
   "id": "check",
   "name": "Check and test"
  }
 ],
